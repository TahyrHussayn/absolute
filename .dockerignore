/assets/node_modules/
/priv/static/assets/
/priv/static/cache_manifest.json

# Local Environment Variables & Secrets
.env
.env.local
.env.*.local

# Terraform Local State & Cache
infra/.terraform/
*.tfstate
*.tfstate.*
infra/.terraform.lock.hcl
